# Kopieer naar .env.development.local (dev) en .env.production.local (prod).
# `npm run dev` leest development, `npm run build` leest production.
# Waarden staan in de Firebase console: Projectinstellingen → Jouw apps → Web-app.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true: gebruik de lokale emulators (demo-project) in plaats van Firebase.
VITE_USE_EMULATOR=
